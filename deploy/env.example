# Copy to .env in the project folder on the server and fill in. Never commit the real .env.

# The site's domain; its DNS A record must point to the server's static IP.
PDD_DOMAIN=pidi.example.com

# How projects are paid for:
#   keys    (default) each person connects their own AI provider on the Account page (web/keys.py):
#           OpenAI, Anthropic (Claude), Google (Gemini), or this server's Ollama (providers.py)
#   credits every project runs on the server's OPENAI_API_KEY and people pay with credits (web/credits.py)
PDD_BILLING=keys
# PDD_ALLOW_SERVER_KEY=false   # with keys: let people without a key use OPENAI_API_KEY (at your expense)
# PDD_OLLAMA_URL=http://localhost:11434   # offers Ollama to everyone; only you set where it runs
# Default models per provider (a person can name another one next to their key):
# PDD_MODEL=gpt-4.1-mini  PDD_STRUCTURE_MODEL=gpt-4.1                 # OpenAI: screenshots, writing
# PDD_ANTHROPIC_CAPTION_MODEL=claude-opus-5-5  PDD_ANTHROPIC_MODEL=claude-opus-5-5
# PDD_GEMINI_CAPTION_MODEL=gemini-3.5-flash-lite  PDD_GEMINI_MODEL=gemini-3.8-flash
# PDD_OLLAMA_CAPTION_MODEL=qwen2.5vl  PDD_OLLAMA_MODEL=qwen2.5vl  PDD_OLLAMA_CONTEXT=32768
# PDD_OLLAMA_THINK=false         # "thinking" models are very slow on a home GPU; true turns thinking on
# Narration without an OpenAI key: Whisper on this server (faster-whisper, downloaded on first use)
# PDD_WHISPER_MODEL=small        # tiny, base, small, medium, large-v3: larger reads better, runs slower

# The server's OpenAI key. Required with PDD_BILLING=credits; with keys, only for PDD_ALLOW_SERVER_KEY.
# Make it a key of its own OpenAI project, with a monthly budget limit in the OpenAI dashboard.
OPENAI_API_KEY=sk-...

# Log in with Google: the OAuth client from Google Cloud Console (deploy/LIGHTSAIL.md, step 4).
PDD_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
PDD_GOOGLE_CLIENT_SECRET=

# One user: add your email with `docker compose exec app python -m web.create_user you@example.com`
# and keep sign-up closed, so no other Google account can create an account.
PDD_ALLOW_SIGNUP=false

# Only for Pidi on your own computer, without Google: the server prints a secret log-in link when it starts.
# Leave it off on a server (anyone who can read its log could log in).
# PDD_LOCAL_LOGIN=true

# Who runs the site, shown in the privacy notice (/privacy) as the data controller and contact.
PDD_OPERATOR_NAME=Your name or company
PDD_CONTACT_EMAIL=you@example.com

# Outgoing email, for alerts. Any SMTP provider works (deploy/LIGHTSAIL.md
# has Amazon SES and Gmail). Without PDD_SMTP_HOST, emails are only written to the log (docker compose logs app).
PDD_SMTP_HOST=email-smtp.sa-east-1.amazonaws.com
PDD_SMTP_PORT=587
PDD_SMTP_USER=
PDD_SMTP_PASSWORD=
PDD_MAIL_FROM=Pidi <no-reply@example.com>
# Failed projects and server errors are emailed here.
PDD_ALERT_EMAIL=you@example.com

# Optional:
# PDD_RETENTION_DAYS=30        # recordings are deleted this many days after their document; 0 keeps them
# PDD_WORKERS=2                # projects processed at the same time
# PDD_RUNS_PER_USER=1          # of which at most this many per person
# With PDD_BILLING=credits:
# PDD_CREDITS_PER_MINUTE=1     # a project's price, per started minute of recording
# PDD_SIGNUP_CREDITS=10        # given to each new account
# PDD_MAX_COST_PER_CREDIT_USD=0.15  # a project whose OpenAI cost goes over this per credit stops (credits given back)

# Buying credits with Asaas (deploy/LIGHTSAIL.md, step 9). Without them, credits are only given by command.
# PDD_ASAAS_API_KEY=$aact_hmlg_...   # sandbox keys start $aact_hmlg_, production keys $aact_prod_
# PDD_ASAAS_SANDBOX=true             # false with a production key: real payments
# PDD_ASAAS_WEBHOOK_TOKEN=           # a long random text; the same in Asaas's webhook settings
# PDD_CREDIT_PRICE_CENTS=150         # one credit, in cents of a real
# PDD_CREDIT_MIN=10                 # fewest credits one purchase may be (keeps the R$1.99 Pix fee small)
# PDD_CREDIT_MAX=1000               # most credits one purchase may be
# PDD_CREDIT_PACKS=10,30            # fixed packs; a last card lets people choose any number
# PDD_MAX_UPLOAD_MB=2048       # largest recording accepted
# PDD_SESSION_DAYS=7           # how long a login lasts
